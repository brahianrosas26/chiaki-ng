+		chiaki_mutex_unlock(&ctrl->notif_mutex);
+		chiaki_multislot_ctrl_received(ctrl->session, msg_type, payload, payload_size);
+		chiaki_mutex_lock(&ctrl->notif_mutex);
+		return;
+	}
 
 	switch(msg_type)
 	{
@@ -892,7 +905,7 @@ static void ctrl_message_received(ChiakiCtrl *ctrl, uint16_t msg_type, uint8_t *
 			ctrl_message_received_switch_to_stream_connection(ctrl, payload, payload_size);
